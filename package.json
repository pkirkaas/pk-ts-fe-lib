{
  "name": "pk-ts-fe-lib",
  "author": "Paul Kirkaas",
  "license": "UNLICENSED",
  "description": "TS/JS Front End (React & SASS) Utilities - MAYBE DANGEROUS FORCE TO REACT 19 BETA!",
  "private": true,
  "type": "module",
  "module": "./dist/esm/index.js",
  "main": "./dist/cjs/index.js",
  "style": "./src/Reset-Css-2023.css",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./react-hook-form": {
      "types": "./dist/esm/react-hook-form/index.d.ts",
      "import": "./dist/esm/react-hook-form/index.js",
      "require": "./dist/cjs/react-hook-form/index.js",
      "default": "./dist/esm/react-hook-form/index.js"
    },
    "./react-utils": {
      "types": "./dist/esm/react-utils/index.d.ts",
      "import": "./dist/esm/react-utils/index.js",
      "require": "./dist/cjs/react-utils/index.js",
      "default": "./dist/esm/react-utils/index.js"
    },
    "./reset.css": "./src/Reset-Css-2023.css",
    "./pk-tailwind.css": "./src/pk-tailwind.css",
    "./scss/pk-default": "./scss/pk-default.scss",
    "./tsconfig.json": "./tsconfig.json",
    "./tsconfig.cjs.json": "./tsconfig.cjs.json"
  },
  "scripts": {
    "clean": "rm -rf ./dist ./package-lock.json ./node_modules",
    "cleanif": "npm run clean && npm i --force",
    "cleani": "npm run clean && npm i",
    "reset": "npm run clean && npm run build",
    "build:sass": "sass --load-path=./node_modules --embed-sources ./scss/pk-default.scss  ./build/assets/cli.css",
    "build:sasstst": "sass --load-path=./node_modules --embed-sources ./scss/tst.scss  ./build/assets/clitst.css",
    "monitor": "nodemon --exec \"npm run build-lib\" --ext js,jsx,ts,tsx,sass,css,scss --delay 5 --watch ./src",
    "devlink": "npm link && npm link pk-ts-common-lib",
    "dev": "vite --open",
    "build": "npm run build-lib && vite build",
    "copycss": "copyfiles -u 1 ./src/**/*.module.css ./dist/esm/",
    "build-lib": "tsc -p ./tsconfig.json && npm run copycss",
    "build-lib-cjs": "tsc -p ./tsconfig.json && tsc -p ./tsconfig.cjs.json",
    "build-cjs": "tsc -p ./tsconfig.cjs.json",
    "preview": "vite preview --open"
  },
  "dependencies": {
    "@emotion/cache": "*",
    "@emotion/css": "*",
    "@emotion/react": "*",
    "@emotion/styled": "*",
    "@mui/icons-material": "*",
    "@mui/material": "*",
    "@mui/system": "*",
    "@popperjs/core": "*",
    "@preact/signals-react": "*",
    "@tailwindcss/container-queries": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "autoprefixer": "*",
    "bootstrap": "*",
    "copyfiles": "*",
    "daisyui": "*",
    "formik": "*",
    "immer": "*",
    "jotai": "*",
    "jotai-immer": "*",
    "jsdom": "*",
    "pk-ts-common-lib": "github:pkirkaas/pk-ts-common-lib#working",
    "postcss": "*",
    "postcss-import": "*",
    "postcss-modules": "*",
    "react": "^19.0.0",
    "react-bootstrap": "*",
    "react-daisyui": "*",
    "react-dom": "^19.0.0",
    "react-hook-form": "*",
    "react-resizable-panels": "*",
    "react-router-dom": "*",
    "react-select": "*",
    "reactjs-popup": "*",
    "sass": "*",
    "styled-components": "*",
    "swr": "*",
    "tailwindcss": "*",
    "tailwind-merge": "*",
    "the-new-css-reset": "*",
    "typescript-plugin-css-modules": "^5.1.0",
    "use-immer": "*",
    "yup": "*"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "*",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@vitejs/plugin-react": "*",
    "pk-ts-node-lib": "github:pkirkaas/pk-ts-node-lib#working",
    "typescript": "*",
    "vite": "*"
  },
  "deprecatedDeps": {
    "no": "none"
  }
}
