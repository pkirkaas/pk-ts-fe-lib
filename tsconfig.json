{
  "extends": "pk-ts-common-lib/tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/esm",
    //"jsx": "react-jsx",
    "jsx": "preserve",
    //EXPERIMENTS!
    //  "target": "ESNext",
    //"module": "ESNext",
    "resolvePackageJsonImports": true,
    "esModuleInterop": true,
    "plugins": [
      {
        "name": "typescript-plugin-css-modules"
      }
    ],
    "paths": { "@/*": [ "./src/*" ], },
  },
    "include": [ "./src/**/*" ],
    "exclude": [ "./dist/esm" ],
  }
    



    /*
    "target": "ESNext",
